diff --git a/CMakeLists.txt b/CMakeLists.txt
index ed06363..260768b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -51,6 +51,23 @@ endif()
 set(CMAKE_CUDA_ARCHITECTURES ${CUDAARCHS})
 message(STATUS "CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES}")

+# Blackwell (SM120) can build real sm_120 cubins with CUDA 12.8, while Flux's
+# op registry and generator currently group Hopper-family GMMA/TMA kernels under
+# the logical Sm90 key.  Keep code generation on Sm90 when compiling for SM120;
+# the emitted CUDA is still compiled for the requested CMAKE_CUDA_ARCHITECTURES.
+set(GENERATOR_CUDAARCHS "")
+foreach(ARCH ${CMAKE_CUDA_ARCHITECTURES})
+  if(ARCH STREQUAL "120")
+    list(APPEND GENERATOR_CUDAARCHS "80")
+    list(APPEND GENERATOR_CUDAARCHS "90")
+  else()
+    list(APPEND GENERATOR_CUDAARCHS "${ARCH}")
+  endif()
+endforeach()
+list(REMOVE_DUPLICATES GENERATOR_CUDAARCHS)
+list(JOIN GENERATOR_CUDAARCHS ";" GENERATOR_CUDAARCHS)
+message(STATUS "GENERATOR_CUDAARCHS=${GENERATOR_CUDAARCHS}")
+
 set(SM_CORES "")
 option(GPU_SM_CORES "Manually specify GPU SM core number (e.g., '108;78'). Overrides auto-detection." "")

@@ -162,6 +179,8 @@ if(BUILD_THS)
       list(APPEND TORCH_CUDA_ARCH_LIST "8.9")
     elseif(ARCH STREQUAL "90")
       list(APPEND TORCH_CUDA_ARCH_LIST "9.0")
+    elseif(ARCH STREQUAL "120")
+      list(APPEND TORCH_CUDA_ARCH_LIST "12.0")
     else()
       message(WARNING "Unsupported CUDA arch [${ARCH}] for TORCH_CUDA_ARCH")
     endif()
