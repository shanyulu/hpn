+PyTuningRecord
+ProfilingContext::get_latest_record_at(int top_index) const {
+  FLUX_CHECK(top_index >= 0) << "top_index must be non-negative";
+  FLUX_CHECK(latest_key_ptr != nullptr) << "no latest prof results found";
+  auto key = *latest_key_ptr;
+  auto iter = prof_results.find(key);
+  FLUX_CHECK(iter != prof_results.end())
+      << "key not found: (" << key.first << ", " << key.second << ")";
+  auto [meta, rt_conf] = key;
+  auto const &top_hparams = iter->second;
+  FLUX_CHECK(top_index < static_cast<int>(top_hparams.size()))
+      << "top_index " << top_index << " is out of range for " << top_hparams.size()
+      << " tuning records";
+  auto hparams_iter = top_hparams.begin();
+  std::advance(hparams_iter, top_index);
+  return PyTuningRecord(meta, rt_conf, hparams_iter->second);
+}
